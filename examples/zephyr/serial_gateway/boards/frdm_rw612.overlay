/* A board overlay replaces app.overlay, which mounts the credentials file system */
#include "../app.overlay"

&pinctrl {
	/* The Flexcomm1 hardware slave select glitches CS, which the SPI device
	 * can see as the end of a transaction. CS is driven as a GPIO instead.
	 *
	 * Override the board's pinmux_flexcomm1_spi, which includes BOTH an SS0
	 * and an SS1 group. On the RW61x, each Flexcomm1 SPI function is a single
	 * bit that routes a 4-pin bundle at once: SS0 (FC1 bit 3) routes GPIO 6/7/8/9,
	 * and SS1 (FC1 bit 5) routes GPIO 7/8/9/10, with SSEL on GPIO 6 and 10
	 * respectively. The MCI_IO_MUX pinctrl driver clears all conflicting
	 * flexcomm bits for each pin before setting the new function, so only one
	 * bundle can be active, and GPIO 6 can only be a plain GPIO if SS0 is unused.
	 *
	 * Use the SS1 bundle for SCK/MISO/MOSI, which leaves GPIO 6 free for CS.
	 * The driver still asserts hardware SSEL0, which isn't routed to any pin,
	 * and GPIO 10 carries the unused SSEL1.
	 */
	pinmux_flexcomm1_spi_gpio_cs: pinmux_flexcomm1_spi_gpio_cs {
		group0 {
			pinmux = <IO_MUX_GPIO6>;
			slew-rate = "ultra";
		};

		group1 {
			pinmux = <IO_MUX_FC1_SPI_SS1>;
			slew-rate = "ultra";
		};
	};
};

&arduino_spi {
	/* SPI on J2:
	 * GPIO 6: CS  (GPIO)
	 * GPIO 7: SCK
	 * GPIO 8: MISO
	 * GPIO 9: MOSI
	 */
	status = "okay";
	pinctrl-0 = <&pinmux_flexcomm1_spi_gpio_cs>;
	pinctrl-names = "default";
	cs-gpios = <&hsgpio0 6 GPIO_ACTIVE_LOW>;

	def-char = <0>;
	overrun-character = <0>;

	pouch_broker: pouch-broker@0 {
		compatible = "golioth,pouch-broker";
		reg = <0>;
		spi-max-frequency = <100000>;
		data-ready-gpios = <&hsgpio0 15 GPIO_ACTIVE_HIGH>;
	};
};
